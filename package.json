{
    "name": "igrounding",
    "private": true,
    "version": "1.0.4",
    "type": "module",
    "author": "Michael Poulgrain",
    "repository": {
        "type": "git",
        "url": "https://github.com/Michaelp1994/transmission-lines"
    },
    "scripts": {
        "bump": "npm version patch && git push --follow-tags",
        "build": "turbo run build",
        "package": "turbo run package",
        "clean": "turbo run clean && rm -rf .turbo node_modules dist releases",
        "db:push": "turbo run db:push",
        "dev": "turbo run dev",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "turbo run lint --continue",
        "lint:fix": "turbo run lint:fix --continue",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "generate": "turbo run generate",
        "prepare": "husky",
        "commitlint": "commitlint --edit"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "commitizen": "^4.3.1",
        "commitlint": "^19.5.0",
        "husky": "^9.1.6",
        "prettier": "^3.3.3",
        "semantic-release": "^24.1.3",
        "turbo": "^2.2.3"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "dependencies": {
        "@changesets/cli": "^2.27.9"
    }
}
